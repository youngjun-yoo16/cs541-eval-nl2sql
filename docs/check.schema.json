{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Allowlisted SQL verification check",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "check_type", "rule_id", "dialect", "applicability", "diagnostic", "explanation", "suggested_correction", "confidence", "provenance"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "check_type": {"const": "static_rule"},
    "rule_id": {"enum": ["order_direction_intent", "count_distinct_intent", "count_nullable_column", "cartesian_join"]},
    "dialect": {"const": "duckdb"},
    "applicability": {
      "type": "object",
      "required": ["description", "database_ids", "terms", "tables", "columns"],
      "properties": {
        "description": {"type": "string"},
        "database_ids": {"type": "array", "items": {"type": "string"}},
        "terms": {"type": "array", "items": {"type": "string"}},
        "tables": {"type": "array", "items": {"type": "string"}},
        "columns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "diagnostic": {"type": "object", "required": ["procedure", "parameters"], "properties": {"procedure": {"type": "string"}, "parameters": {"type": "object"}}, "additionalProperties": false},
    "explanation": {"type": "string"},
    "suggested_correction": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "object", "required": ["source_example_ids", "created_by", "validation_summary"], "properties": {"source_example_ids": {"type": "array", "items": {"type": "string"}}, "created_by": {"type": "string"}, "validation_summary": {"type": "string"}}, "additionalProperties": false}
  }
}
